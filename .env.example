# Option 1: provide a full MongoDB connection string
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Option 2: provide the individual components for the URI
MONGO_USER=
MONGO_PASS=
MONGO_CLUSTER=
MONGO_DB=test
MONGO_INPUT_COLLECTION=batch_aa
MONGO_OUTPUT_COLLECTION=output_batch_aa